{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/rag-retrieval-evaluation.schema.json",
  "title": "Offline retrieval evaluation dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_status", "description", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_status": {"enum": ["template", "annotated"]},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "query", "relevant_chunks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "query": {"type": "string", "minLength": 1},
          "notes": {"type": "string"},
          "relevant_chunks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file_title", "content_contains"],
              "properties": {
                "file_title": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "content_contains": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
